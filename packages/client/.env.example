# Client Environment Variables
# Copy this file to .env.local and fill in values for your environment.

# API base URL for the Express backend.
# Default (if unset): http://<window.location.hostname>:4000
# Set this when deploying behind an HTTPS reverse proxy or a custom domain.
# Example for staging:
# VITE_API_URL=https://api.staging.levelupgamezone.com
VITE_API_URL=
