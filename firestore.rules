rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string (optional)
    //   - role: string (required, enum: ['admin', 'manager', 'staff'])
    //
    // Collection: game_rates
    // Document ID: {rateId}
    // Fields:
    //   - game_name: string (required)
    //   - price_per_unit: number (required)
    //   - unit_type: string (required, enum: ['Hour', 'Game'])
    //   - isActive: boolean (required)
    //
    // Collection: game_sales_logs
    // Document ID: {logId}
    // Fields:
    //   - game_id: string (required)
    //   - game_name: string (required)
    //   - quantity_sold: number (required)
    //   - rate_applied: number (required)
    //   - calculated_total: number (required)
    //   - user_id: string (required)
    //   - date: string (required, ISO date string)
    //
    // Collection: keno_logs
    // Document ID: {logId}
    // Fields:
    //   - sales: number (required)
    //   - payouts: number (required)
    //   - net_profit: number (required)
    //   - user_id: string (required)
    //   - date: string (required, ISO date string)
    //
    // Collection: credits
    // Document ID: {creditId}
    // Fields:
    //   - employee_name: string (required)
    //   - amount: number (required)
    //   - status: string (required, enum: ['Pending', 'Deducted'])
    //   - user_id: string (required)
    //   - date: string (required, ISO date string)
    //
    // Collection: expenses
    // Document ID: {expenseId}
    // Fields:
    //   - description: string (required)
    //   - amount: number (required)
    //   - user_id: string (required)
    //   - date: string (required, ISO date string)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role checks
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'admin' ||
        (request.auth.token.email == "bezueyob3@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isManagerOrAdmin() {
      return isAdmin() || (isAuthenticated() && getUserRole() == 'manager');
    }

    function isStaffOrHigher() {
      return isManagerOrAdmin() || (isAuthenticated() && getUserRole() == 'staff');
    }

    // ===============================================================
    // Rules (Locked Down for Thin Client Architecture)
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isManagerOrAdmin();
      allow write: if false;
    }

    match /game_rates/{rateId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /shifts/{shiftId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isManagerOrAdmin();
      allow write: if false;
    }

    match /game_sales_logs/{logId} {
      allow read: if isStaffOrHigher();
      allow write: if false;
    }

    match /keno_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /credits/{creditId} {
      allow read: if isManagerOrAdmin();
      allow write: if false;
    }

    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
