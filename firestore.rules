rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string (optional)
    //   - role: string (required, enum: ['admin', 'manager', 'staff'])
    //
    // Collection: game_rates
    // Document ID: {rateId}
    // Fields:
    //   - game_name: string (required)
    //   - price_per_unit: number (required)
    //   - unit_type: string (required, enum: ['Hour', 'Game'])
    //   - isActive: boolean (required)
    //
    // Collection: game_sales_logs
    // Document ID: {logId}
    // Fields:
    //   - game_id: string (required)
    //   - game_name: string (required)
    //   - quantity_sold: number (required)
    //   - rate_applied: number (required)
    //   - calculated_total: number (required)
    //   - user_id: string (required)
    //   - date: string (required, ISO date string)
    //
    // Collection: keno_logs
    // Document ID: {logId}
    // Fields:
    //   - sales: number (required)
    //   - payouts: number (required)
    //   - net_profit: number (required)
    //   - user_id: string (required)
    //   - date: string (required, ISO date string)
    //
    // Collection: credits
    // Document ID: {creditId}
    // Fields:
    //   - employee_name: string (required)
    //   - amount: number (required)
    //   - status: string (required, enum: ['Pending', 'Deducted'])
    //   - user_id: string (required)
    //   - date: string (required, ISO date string)
    //
    // Collection: expenses
    // Document ID: {expenseId}
    // Fields:
    //   - description: string (required)
    //   - amount: number (required)
    //   - user_id: string (required)
    //   - date: string (required, ISO date string)
    //
    // ===============================================================

    // ===============================================================
    // Rules (Zero-Trust Thin Client Architecture Lockdown)
    // ===============================================================
    // All data operations are mediated through the Express Backend API
    // using the firebase-admin SDK. Direct client access is disabled.
    // No helper functions are declared: an unreferenced function emits
    // an "Unused function" warning from the Firestore Rules compiler.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
