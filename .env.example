# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIRESTORE_DATABASE_ID (server, optional): named Firestore database.
# Unset = project default database. Previously lived in the client's
# firebase-applet-config.json (TD-016).
FIRESTORE_DATABASE_ID=

# CORS_ORIGINS (server, optional): comma-separated allowlist of browser
# origins permitted to call the API (TD-010, M-86).
# Unset = loopback dev defaults: http://localhost:3000, http://localhost:3002,
# http://localhost:5173. Non-browser clients (no Origin header) are always
# permitted.
CORS_ORIGINS=

# RATE_LIMIT_WINDOW_MS (server, optional): sliding window for rate limiters in
# milliseconds. Unset = 900000 (15 minutes). (TD-011, M-86)
RATE_LIMIT_WINDOW_MS=

# API_RATE_LIMIT_MAX (server, optional): max requests per IP per window across
# all /api routes. Unset = 300. (TD-011, M-86)
API_RATE_LIMIT_MAX=

# MUTATION_RATE_LIMIT_MAX (server, optional): stricter per-IP budget for
# POST/PUT/PATCH/DELETE within the same window. Unset = 60. (TD-011, M-86)
MUTATION_RATE_LIMIT_MAX=
