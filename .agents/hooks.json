{
	"wake-protocol": {
		"PreInvocation": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "bash .agents/scripts/wake_summary.sh",
						"timeout": 10
					}
				]
			}
		],
		"PreAgentResponse": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "bash .agents/scripts/wake_summary.sh",
						"timeout": 10
					}
				]
			}
		]
	},
	"execution-ledger-pre": {
		"PreToolUse": [
			{
				"matcher": "write_to_file",
				"hooks": [
					{
						"type": "command",
						"command": "bash .agents/scripts/log_ledger.sh \"PreToolUse\" \"write_to_file\" \"{{tool.args.TargetFile}}\" \"SUCCESS\" 0",
						"timeout": 5
					}
				]
			},
			{
				"matcher": "replace_file_content",
				"hooks": [
					{
						"type": "command",
						"command": "bash .agents/scripts/log_ledger.sh \"PreToolUse\" \"replace_file_content\" \"{{tool.args.TargetFile}}\" \"SUCCESS\" 0",
						"timeout": 5
					}
				]
			},
			{
				"matcher": "multi_replace_file_content",
				"hooks": [
					{
						"type": "command",
						"command": "bash .agents/scripts/log_ledger.sh \"PreToolUse\" \"multi_replace_file_content\" \"{{tool.args.TargetFile}}\" \"SUCCESS\" 0",
						"timeout": 5
					}
				]
			}
		]
	},
