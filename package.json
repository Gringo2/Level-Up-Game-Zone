{
  "name": "level-up-game-zone",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=@level-up/client",
    "dev:server": "npm run dev --workspace=@level-up/server",
    "dev": "npm run dev:server & npm run dev:client",
    "build:client": "npm run build --workspace=@level-up/client",
    "build:server": "npm run build --workspace=@level-up/server",
    "install:all": "npm install"
  }
}
