{
	"name": "level-up-game-zone",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev:server & npm run dev:client",
		"dev:client": "npm run dev --workspace=@level-up/client",
		"dev:server": "npm run dev --workspace=@level-up/server",
		"predev:server": "npm run build --workspace=@level-up/shared",
		"build": "npm run build --workspace=@level-up/shared && npm run build:client && npm run build:server",
		"build:client": "npm run build --workspace=@level-up/client",
		"build:server": "npm run build --workspace=@level-up/server",
		"start": "node packages/server/dist/index.js",
		"install:all": "npm install",
		"depcruise": "depcruise packages --include-only '^packages' --no-config --output-type html > dependency-report.html",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"knip": "knip",
		"scan": "semgrep scan --config auto",
		"prepare": "husky"
	},
	"devDependencies": {
		"@ast-grep/cli": "^0.39.0",
		"@biomejs/biome": "2.5.6",
		"@playwright/test": "^1.62.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitest/coverage-v8": "^4.1.10",
		"dependency-cruiser": "^18.1.0",
		"husky": "^9.1.7",
		"knip": "^6.29.0",
		"lint-staged": "^17.2.0",
		"vitest": "^4.1.10"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"overrides": {
		"uuid": "11.1.1"
	}
}
